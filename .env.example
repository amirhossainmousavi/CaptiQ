PORT=3000
NODE_ENV=development

AI_PROVIDER=your_ai_provider_here
AI_API_KEY=your_api_key_here
AI_MODEL=the_model_you_want_to_use_here

YT_DLP_PATH=the_path_to_your_yt_dlp_executable_here
YT_DLP_TIMEOUT_MS=the_timeout_in_milliseconds_here

# Optional: e.g., chrome, firefox
YT_DLP_COOKIES_FILE=the_path_to_your_cookies_file_here (e.g., ./cookies.txt)
# Optional: e.g., http://user:pass@host:port
YT_DLP_PROXY=the_proxy_you_want_to_use_here (e.g., http://user:pass@host:port) 

CACHE_DIR=the_path_to_your_cache_directory_here (e.g., ./cache)
CACHE_TTL_HOURS=the_cache_ttl_in_hours_here (e.g., 168)

ALLOWED_ORIGIN=the_origin_you_want_to_allow_here (e.g., chrome-extension://YOUR_EXTENSION_ID)
